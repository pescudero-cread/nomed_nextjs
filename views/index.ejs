<!-- Hero Section -->
<section id="inicio" class="bg-gradient-to-r from-nomed-gradient-start to-nomed-gradient-end text-white py-20 relative overflow-hidden">
    <!-- Efectos de fondo -->
    <div class="absolute inset-0 bg-gradient-to-br from-nomed-primary-light to-nomed-primary-bright opacity-20"></div>
    <div class="floating-particles"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-8 animate-slide-in-left">
                <h1 class="text-4xl lg:text-6xl font-bold font-poppins">
                    Transformando la educación con
                    <span class="text-botbee-highlight animate-gradient-x">inteligencia artificial</span>
                </h1>
                <p class="text-xl leading-relaxed">
                    Soluciones digitales que optimizan el aprendizaje de estudiantes y docentes 
                    mediante inteligencia artificial, creando experiencias educativas innovadoras.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <button class="bg-botbee-honey text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-botbee-honey-dark transition-colors animate-bounce-in hover-lift">
                        Comenzar Ahora
                    </button>
                    <button class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-nomed-primary transition-colors hover-lift">
                        Ver Demo
                    </button>
                </div>
            </div>
            <div class="relative animate-slide-in-right">
                <div class="bg-white bg-opacity-10 backdrop-blur-lg rounded-2xl p-8 border border-white border-opacity-20 character-hover">
                    <div class="text-center space-y-6">
                        <div class="w-32 h-32 mx-auto character-entrance">
                            <img src="/images/characters/botbee.svg" alt="Botbee - Abeja Educativa" class="w-full h-full">
                        </div>
                        <h3 class="text-2xl font-bold">IA Educativa</h3>
                        <p class="text-lg opacity-90">Personalización del aprendizaje para cada estudiante</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios Section -->
<section id="servicios" class="py-20 bg-nomed-background">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-primary">Nuestros Servicios</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Descubre nuestras herramientas de IA diseñadas para revolucionar la educación
            </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Botbee -->
            <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow border border-botbee-honey border-opacity-20 animate-fade-in hover-lift">
                <div class="w-20 h-20 mx-auto mb-4 character-hover">
                    <img src="/images/characters/botbee.svg" alt="Botbee - Abeja Educativa" class="w-full h-full">
                </div>
                <h3 class="text-xl font-bold text-botbee-honey mb-3">Botbee</h3>
                <p class="text-gray-600 mb-4">Personajes interactivos para el aprendizaje dinámico</p>
                <a href="/botbee" class="bg-botbee-honey text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-botbee-honey-dark transition-colors inline-block hover-lift">
                    ¡Crea tu personaje interactivo ahora!
                </a>
            </div>

            <!-- Monkit -->
            <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow border border-monkit-orange border-opacity-20 animate-fade-in hover-lift">
                <div class="w-20 h-20 mx-auto mb-4 character-hover">
                    <img src="/images/characters/monkit.svg" alt="Monkit - Mono Constructor" class="w-full h-full">
                </div>
                <h3 class="text-xl font-bold text-monkit-orange mb-3">Monkit</h3>
                <p class="text-gray-600 mb-4">Herramientas para crear contenido educativo interactivo</p>
                <a href="/monkit" class="bg-monkit-orange text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-monkit-orange-deep transition-colors inline-block hover-lift">
                    Empieza a crear contenido educativo
                </a>
            </div>

            <!-- Quizzal -->
            <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow border border-quizzal-green border-opacity-20 animate-fade-in hover-lift">
                <div class="w-20 h-20 mx-auto mb-4 character-hover">
                    <img src="/images/characters/quizzal.svg" alt="Quizzal - Búho Evaluador" class="w-full h-full">
                </div>
                <h3 class="text-xl font-bold text-quizzal-green mb-3">Quizzal</h3>
                <p class="text-gray-600 mb-4">Plataforma de evaluaciones personalizadas</p>
                <a href="/quizzal" class="bg-quizzal-green text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-quizzal-forest transition-colors inline-block hover-lift">
                    Crea tu evaluación personalizada ahora
                </a>
            </div>

            <!-- App Nomed -->
            <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow border border-app-nomed-blue border-opacity-20 animate-fade-in hover-lift">
                <div class="w-20 h-20 mx-auto mb-4 character-hover">
                    <img src="/images/characters/app-nomed.svg" alt="App Nomed - Robot Inteligente" class="w-full h-full">
                </div>
                <h3 class="text-xl font-bold text-app-nomed-blue mb-3">App Nomed</h3>
                <p class="text-gray-600 mb-4">Refuerzo académico interactivo para estudiantes</p>
                <a href="/app-nomed" class="bg-app-nomed-blue text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-nomed-primary transition-colors inline-block hover-lift">
                    Accede a nuestra app para mejorar tu aprendizaje
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Testimonios Section -->
<section class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-primary">Testimonios de Usuarios</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Descubre cómo nuestras herramientas han transformado la experiencia educativa
            </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            <% testimonials.forEach((testimonial, index) => { %>
            <div class="bg-nomed-background rounded-2xl p-8 text-center animate-slide-up">
                <div class="w-20 h-20 bg-nomed-primary rounded-full mx-auto mb-6 flex items-center justify-center">
                    <span class="text-2xl font-bold text-white"><%= testimonial.avatar %></span>
                </div>
                <h4 class="text-xl font-bold text-nomed-primary mb-2"><%= testimonial.name %></h4>
                <p class="text-gray-600 mb-4"><%= testimonial.role %></p>
                <p class="text-gray-700 italic">
                    "<%= testimonial.quote %>"
                </p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Sobre Nosotros Section -->
<section id="sobre-nosotros" class="py-20 bg-nomed-background">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-8 animate-slide-in-left">
                <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-primary">Sobre Nosotros</h2>
                <div class="space-y-6">
                    <div>
                        <h3 class="text-2xl font-bold text-nomed-secondary mb-3">Nuestra Misión</h3>
                        <p class="text-gray-700 leading-relaxed">
                            Mejorar la calidad educativa mediante el uso de inteligencia artificial para crear 
                            herramientas digitales que optimicen el proceso de aprendizaje y hagan la educación 
                            más accesible e interactiva para todos.
                        </p>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold text-nomed-accent-medium mb-3">Nuestra Visión</h3>
                        <p class="text-gray-700 leading-relaxed">
                            Ser líderes en la transformación educativa a través de la tecnología, 
                            creando un mundo donde el aprendizaje sea personalizado, eficiente y 
                            accesible para estudiantes de todas las edades y contextos.
                        </p>
                    </div>
                </div>
            </div>
            <div class="space-y-8 animate-slide-in-right">
                <h3 class="text-2xl font-bold text-nomed-primary">Nuestro Equipo</h3>
                <div class="grid grid-cols-2 gap-6">
                    <% team.forEach((member, index) => { %>
                    <div class="text-center">
                        <div class="w-24 h-24 bg-nomed-primary rounded-full mx-auto mb-4 flex items-center justify-center">
                            <span class="text-2xl font-bold text-white"><%= member.avatar %></span>
                        </div>
                        <h4 class="font-bold text-nomed-primary"><%= member.name %></h4>
                        <p class="text-sm text-gray-600"><%= member.role %></p>
                    </div>
                    <% }); %>
                </div>
                <div class="bg-white rounded-2xl p-6">
                    <h4 class="text-xl font-bold text-nomed-primary mb-3">Alianzas</h4>
                    <p class="text-gray-700">
                        Trabajamos en colaboración con la <strong>Asociación CREAD</strong> y otras 
                        organizaciones educativas para reforzar nuestro compromiso con la mejora 
                        de la calidad educativa.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contacto Section -->
<section id="contacto" class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
            <div class="text-center space-y-4 mb-16">
                <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-primary">Contacto</h2>
                <p class="text-xl text-gray-600">
                    ¿Listo para transformar tu experiencia educativa? ¡Contáctanos!
                </p>
            </div>
            
            <div class="grid lg:grid-cols-2 gap-12">
                <div class="space-y-8">
                    <div>
                        <h3 class="text-2xl font-bold text-nomed-primary mb-6">Información de Contacto</h3>
                        <div class="space-y-4">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 bg-nomed-primary rounded-lg flex items-center justify-center">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900">Email</h4>
                                    <p class="text-gray-600">contacto@nomed.org</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 bg-nomed-secondary rounded-lg flex items-center justify-center">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900">Ubicación</h4>
                                    <p class="text-gray-600">Santiago, Chile</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-nomed-background rounded-2xl p-8">
                    <h3 class="text-2xl font-bold text-nomed-primary mb-6">Envíanos un Mensaje</h3>
                    <form id="contact-form" class="space-y-6">
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Nombre</label>
                            <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-nomed-primary focus:border-transparent" placeholder="Tu nombre completo">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Email</label>
                            <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-nomed-primary focus:border-transparent" placeholder="tu@email.com">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Mensaje</label>
                            <textarea name="message" rows="4" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-nomed-primary focus:border-transparent" placeholder="Cuéntanos sobre tu proyecto educativo"></textarea>
                        </div>
                        <button type="submit" class="w-full bg-nomed-accent-medium text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                            Enviar Mensaje
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
