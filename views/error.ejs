<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="max-w-md w-full text-center">
        <div class="mb-8">
            <div class="w-24 h-24 bg-red-100 rounded-full mx-auto mb-6 flex items-center justify-center">
                <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 19.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-800 mb-4">Oops! Algo salió mal</h1>
            <p class="text-gray-600 mb-8">
                <%= error || 'Ha ocurrido un error inesperado. Nuestro equipo ha sido notificado.' %>
            </p>
        </div>
        
        <div class="space-y-4">
            <a href="/" class="inline-block bg-nomed-primary text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
                Volver al Inicio
            </a>
            <button onclick="history.back()" class="block mx-auto text-gray-600 hover:text-gray-800 transition-colors">
                ← Volver atrás
            </button>
        </div>
    </div>
</div>
