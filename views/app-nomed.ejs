<!-- Hero Section -->
<section class="py-20 bg-gradient-to-br from-nomed-gradient-start to-nomed-gradient-end">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Character Section -->
            <div class="relative animate-slide-in-left">
                <div class="relative">
                    <!-- Robot Character -->
                    <div class="robot-character relative z-10">
                        <div class="w-80 h-80 mx-auto relative">
                            <!-- Robot Body -->
                            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-40 h-48 bg-gray-400 rounded-lg relative">
                                <!-- Robot Head -->
                                <div class="absolute -top-16 left-1/2 transform -translate-x-1/2 w-32 h-32 bg-gray-300 rounded-lg">
                                    <!-- Antenna -->
                                    <div class="robot-antenna absolute -top-8 left-1/2 transform -translate-x-1/2 w-2 h-8 bg-nomed-secondary">
                                        <div class="absolute -top-2 left-1/2 transform -translate-x-1/2 w-4 h-4 bg-nomed-secondary rounded-full"></div>
                                    </div>
                                    
                                    <!-- Screen -->
                                    <div class="robot-screen absolute top-4 left-1/2 transform -translate-x-1/2 w-20 h-12 bg-blue-500 rounded flex items-center justify-center">
                                        <div class="text-white text-xs font-mono">NOMED</div>
                                    </div>
                                    
                                    <!-- Eyes -->
                                    <div class="robot-eyes absolute bottom-6 left-6 w-4 h-4 bg-white rounded-full flex items-center justify-center">
                                        <div class="w-2 h-2 bg-nomed-secondary rounded-full"></div>
                                    </div>
                                    <div class="robot-eyes absolute bottom-6 right-6 w-4 h-4 bg-white rounded-full flex items-center justify-center">
                                        <div class="w-2 h-2 bg-nomed-secondary rounded-full"></div>
                                    </div>
                                </div>
                                
                                <!-- Arms -->
                                <div class="absolute top-12 -left-6 w-8 h-20 bg-gray-400 rounded-full"></div>
                                <div class="absolute top-12 -right-6 w-8 h-20 bg-gray-400 rounded-full"></div>
                                
                                <!-- Legs -->
                                <div class="absolute bottom-0 left-8 w-8 h-16 bg-gray-500 rounded-full"></div>
                                <div class="absolute bottom-0 right-8 w-8 h-16 bg-gray-500 rounded-full"></div>
                                
                                <!-- Control Panel -->
                                <div class="absolute top-8 left-1/2 transform -translate-x-1/2 w-16 h-8 bg-gray-600 rounded flex items-center justify-center space-x-1">
                                    <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                                    <div class="w-2 h-2 bg-yellow-400 rounded-full"></div>
                                    <div class="w-2 h-2 bg-red-400 rounded-full"></div>
                                </div>
                            </div>
                            
                            <!-- Floating app icons -->
                            <div class="app-preview absolute top-10 left-8 w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-lg">
                                <span class="text-nomed-secondary font-bold text-lg">📱</span>
                            </div>
                            
                            <div class="app-preview absolute top-20 right-12 w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-lg" style="animation-delay: 1s;">
                                <span class="text-nomed-secondary font-bold text-sm">🎮</span>
                            </div>
                            
                            <div class="app-preview absolute bottom-20 left-12 w-8 h-8 bg-white rounded-xl flex items-center justify-center shadow-lg" style="animation-delay: 2s;">
                                <span class="text-nomed-secondary font-bold text-xs">📚</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Floating icons -->
                    <div class="absolute top-10 left-10 w-12 h-12 bg-white bg-opacity-20 rounded-full flex items-center justify-center animate-float">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    
                    <div class="absolute top-32 right-16 w-8 h-8 bg-white bg-opacity-20 rounded-full flex items-center justify-center animate-float" style="animation-delay: 1s;">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    
                    <div class="absolute bottom-20 left-16 w-6 h-6 bg-white bg-opacity-20 rounded-full flex items-center justify-center animate-float" style="animation-delay: 2s;">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>
            
            <!-- Content Section -->
            <div class="space-y-8 animate-slide-in-right">
                <div class="space-y-6">
                    <div class="inline-flex items-center space-x-2">
                        <div class="w-12 h-12 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <span class="text-white text-sm font-medium">APP NOMED</span>
                    </div>
                    
                    <h1 class="text-4xl lg:text-6xl font-bold font-poppins text-white leading-tight">
                        Refuerzo académico interactivo para estudiantes
                    </h1>
                    
                    <p class="text-xl text-white text-opacity-90 leading-relaxed">
                        Aplicación móvil integral con contenido interactivo, gamificación 
                        y aprendizaje personalizado que se adapta a cada estudiante.
                    </p>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-4">
                    <button class="bg-white text-nomed-secondary px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors">
                        Accede a nuestra app para mejorar tu aprendizaje
                    </button>
                    <button class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-nomed-secondary transition-colors">
                        Ver Demo
                    </button>
                </div>
                
                <div class="text-white text-opacity-80">
                    <p class="text-sm">📱 <strong>app.nomed.org</strong></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="caracteristicas" class="py-20 bg-nomed-gray">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-text">Características Principales</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Descubre todas las funcionalidades que App Nomed pone a tu disposición
            </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            <% features.forEach((feature, index) => { %>
            <div class="feature-card bg-white rounded-2xl p-8 shadow-lg">
                <div class="w-16 h-16 bg-nomed-secondary rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <% if (feature.icon === 'book') { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        <% } else if (feature.icon === 'smile') { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <% } else { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <% } %>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-nomed-text mb-4"><%= feature.title %></h3>
                <p class="text-gray-600 leading-relaxed">
                    <%= feature.description %>
                </p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Mobile Preview Section -->
<section id="demo" class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-nomed-text">Vista Previa de la App</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Descubre cómo se ve y funciona App Nomed en tu dispositivo móvil
            </p>
        </div>
        
        <div class="max-w-6xl mx-auto">
            <div class="grid lg:grid-cols-3 gap-8">
                <% mobileScreens.forEach((screen, index) => { %>
                <div class="app-preview flex justify-center">
                    <div class="mobile-screen w-64 h-96 p-4 relative overflow-hidden">
                        <div class="bg-white rounded-2xl h-full p-4">
                            <% if (screen.id === 'welcome') { %>
                            <div class="text-center space-y-4">
                                <div class="w-16 h-16 bg-nomed-secondary rounded-full mx-auto flex items-center justify-center">
                                    <span class="text-white font-bold text-2xl">N</span>
                                </div>
                                <h3 class="text-lg font-bold text-gray-800"><%= screen.title %></h3>
                                <p class="text-sm text-gray-600"><%= screen.subtitle %></p>
                                <div class="space-y-2">
                                    <% screen.content.forEach((item, itemIndex) => { %>
                                    <button class="w-full p-3 <%= item.active ? 'bg-nomed-secondary text-white' : 'bg-gray-200 text-gray-700' %> rounded-lg text-sm font-semibold">
                                        <%= item.text %>
                                    </button>
                                    <% }); %>
                                </div>
                            </div>
                            <% } else if (screen.id === 'quiz') { %>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between">
                                    <h3 class="text-lg font-bold text-gray-800"><%= screen.title %></h3>
                                    <div class="text-sm text-nomed-secondary"><%= screen.level %></div>
                                </div>
                                <div class="bg-gray-200 rounded-full h-2">
                                    <div class="bg-nomed-secondary h-2 rounded-full" style="width: <%= screen.progress %>%"></div>
                                </div>
                                <div class="space-y-3">
                                    <div class="bg-nomed-secondary text-white p-3 rounded-lg">
                                        <div class="text-sm font-semibold"><%= screen.question %></div>
                                        <div class="text-xs mt-1"><%= screen.questionNumber %></div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <% screen.options.forEach((option, optionIndex) => { %>
                                        <button class="p-2 <%= option.correct ? 'bg-green-100 text-green-700' : 'bg-gray-100' %> rounded-lg text-sm">
                                            <%= option.text %>
                                        </button>
                                        <% }); %>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center">
                                    <div class="text-xs text-gray-600">Puntos: <%= screen.points %></div>
                                    <div class="text-xs text-gray-600">Racha: <%= screen.streak %></div>
                                </div>
                            </div>
                            <% } else if (screen.id === 'completion') { %>
                            <div class="space-y-4">
                                <div class="text-center">
                                    <div class="w-16 h-16 bg-yellow-400 rounded-full mx-auto flex items-center justify-center mb-2">
                                        <span class="text-white font-bold text-2xl">🏆</span>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-800"><%= screen.title %></h3>
                                </div>
                                <div class="space-y-2">
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600">Puntuación:</span>
                                        <span class="text-sm font-semibold"><%= screen.score %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600">Tiempo:</span>
                                        <span class="text-sm font-semibold"><%= screen.time %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600">Logros:</span>
                                        <span class="text-sm font-semibold"><%= screen.achievements %></span>
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <% screen.actions.forEach((action, actionIndex) => { %>
                                    <button class="w-full p-3 <%= action.primary ? 'bg-nomed-secondary text-white' : 'bg-gray-200 text-gray-700' %> rounded-lg text-sm font-semibold">
                                        <%= action.text %>
                                    </button>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
</section>

