<style>
    .robot-character {
        position: relative;
        animation: bounce-gentle 2s ease-in-out infinite;
    }
    
    .robot-eyes {
        animation: pulse-slow 2s ease-in-out infinite;
    }
    
    .robot-antenna {
        animation: wiggle 3s ease-in-out infinite;
    }
    
    .robot-screen {
        animation: glow 2s ease-in-out infinite alternate;
    }
    
    .app-icon {
        transition: all 0.3s ease;
    }
    
    .app-icon:hover {
        transform: translateY(-5px) scale(1.1);
    }
    
    .feature-card {
        transition: all 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
    
    .mobile-screen {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 25px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }
    
    .app-preview {
        animation: float 3s ease-in-out infinite;
    }
    
    .app-preview:nth-child(2n) {
        animation-delay: 1s;
    }
    
    .app-preview:nth-child(3n) {
        animation-delay: 2s;
    }
</style>

<script>
    // App download tracking
    document.querySelectorAll('.app-icon').forEach(button => {
        button.addEventListener('click', function() {
            const platform = this.textContent.includes('App Store') ? 'iOS' : 'Android';
            alert(`Redirigiendo a la descarga para ${platform}...`);
        });
    });
</script>
