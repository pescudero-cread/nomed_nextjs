<!-- Features Section -->
<section id="caracteristicas" class="py-20 bg-nomed-gray">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-quizzal-text">Características Principales</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Descubre todas las herramientas que Quizzal pone a tu disposición
            </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            <% features.forEach((feature, index) => { %>
            <div class="quiz-card bg-white rounded-2xl p-8 shadow-lg">
                <div class="w-16 h-16 bg-quizzal-accent rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <% if (feature.icon === 'book') { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        <% } else if (feature.icon === 'zap') { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        <% } else { %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        <% } %>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-quizzal-text mb-4"><%= feature.title %></h3>
                <p class="text-gray-600 leading-relaxed">
                    <%= feature.description %>
                </p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Interactive Demo Section -->
<section id="demo" class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <div class="text-center space-y-4 mb-16">
            <h2 class="text-3xl lg:text-4xl font-bold font-poppins text-quizzal-text">Prueba Quizzal</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Experimenta cómo funciona nuestro sistema de evaluaciones
            </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
            <div class="bg-nomed-gray rounded-2xl p-8">
                <div class="space-y-8">
                    <!-- Quiz Header -->
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 bg-quizzal-accent rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-xl">Q</span>
                            </div>
                            <div>
                                <h3 class="font-semibold text-quizzal-text"><%= demoQuiz.title %></h3>
                                <p class="text-sm text-gray-600">Pregunta <%= demoQuiz.currentQuestion %> de <%= demoQuiz.totalQuestions %></p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-bold text-quizzal-accent"><%= demoQuiz.progress %>%</div>
                            <div class="text-sm text-gray-600">Completado</div>
                        </div>
                    </div>
                    
                    <!-- Progress Bar -->
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="progress-bar bg-quizzal-accent h-2 rounded-full" style="width: <%= demoQuiz.progress %>%"></div>
                    </div>
                    
                    <!-- Question -->
                    <div class="bg-white rounded-2xl p-8">
                        <h4 class="text-xl font-bold text-quizzal-text mb-6">
                            <%= demoQuiz.question %>
                        </h4>
                        
                        <div class="space-y-4">
                            <% demoQuiz.options.forEach((option, index) => { %>
                            <button class="w-full text-left p-4 border-2 border-gray-200 rounded-lg hover:border-quizzal-accent transition-colors" onclick="selectAnswer(this, <%= option.correct %>)">
                                <span class="font-medium"><%= option.id %>)</span> <%= option.text %>
                            </button>
                            <% }); %>
                        </div>
                        
                        <div id="feedback" class="mt-6 hidden">
                            <div class="p-4 rounded-lg">
                                <div id="feedback-content"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Navigation -->
                    <div class="flex justify-between">
                        <button class="px-6 py-3 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors" disabled>
                            ← Anterior
                        </button>
                        <button id="next-btn" class="px-6 py-3 bg-quizzal-accent text-white rounded-lg hover:bg-orange-600 transition-colors" onclick="nextQuestion()" disabled>
                            Siguiente →
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

