<style>
    .owl-character {
        position: relative;
        animation: bounce-gentle 2s ease-in-out infinite;
    }
    
    .owl-eyes {
        animation: pulse-slow 2s ease-in-out infinite;
    }
    
    .owl-wings {
        animation: float 3s ease-in-out infinite;
    }
    
    .quiz-card {
        transition: all 0.3s ease;
    }
    
    .quiz-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
    
    .progress-bar {
        animation: pulse-slow 2s ease-in-out infinite;
    }
    
    .question-mark {
        animation: spin-slow 3s linear infinite;
    }
    
    .feature-icon {
        animation: float 3s ease-in-out infinite;
    }
    
    .feature-icon:nth-child(2n) {
        animation-delay: 1s;
    }
    
    .feature-icon:nth-child(3n) {
        animation-delay: 2s;
    }
</style>

<script>
    let currentQuestion = 1;
    let score = 0;
    
    function selectAnswer(button, isCorrect) {
        // Remove previous selections
        document.querySelectorAll('button').forEach(btn => {
            if (btn.onclick && btn.onclick.toString().includes('selectAnswer')) {
                btn.classList.remove('border-quizzal-accent', 'bg-quizzal-accent', 'text-white', 'border-green-500', 'bg-green-500', 'border-red-500', 'bg-red-500');
                btn.classList.add('border-gray-200');
            }
        });
        
        // Style selected answer
        button.classList.remove('border-gray-200');
        
        if (isCorrect) {
            button.classList.add('border-green-500', 'bg-green-500', 'text-white');
            score++;
        } else {
            button.classList.add('border-red-500', 'bg-red-500', 'text-white');
        }
        
        // Show feedback
        const feedback = document.getElementById('feedback');
        const feedbackContent = document.getElementById('feedback-content');
        
        if (isCorrect) {
            feedbackContent.innerHTML = `
                <div class="flex items-center space-x-2 text-green-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-semibold">¡Correcto!</span>
                </div>
                <p class="mt-2 text-gray-700">Excelente trabajo. 15 + 27 = 42. Has aplicado correctamente la suma de números enteros.</p>
            `;
            feedback.classList.remove('bg-red-50', 'border-red-200');
            feedback.classList.add('bg-green-50', 'border-green-200');
        } else {
            feedbackContent.innerHTML = `
                <div class="flex items-center space-x-2 text-red-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <span class="font-semibold">Incorrecto</span>
                </div>
                <p class="mt-2 text-gray-700">La respuesta correcta es 42. Recuerda: 15 + 27 = (10 + 20) + (5 + 7) = 30 + 12 = 42</p>
            `;
            feedback.classList.remove('bg-green-50', 'border-green-200');
            feedback.classList.add('bg-red-50', 'border-red-200');
        }
        
        feedback.classList.remove('hidden');
        
        // Enable next button
        document.getElementById('next-btn').disabled = false;
    }
    
    function nextQuestion() {
        if (currentQuestion < 5) {
            currentQuestion++;
            // Update progress
            const progressBar = document.querySelector('.progress-bar');
            const progressText = document.querySelector('.text-2xl');
            const progress = (currentQuestion / 5) * 100;
            
            progressBar.style.width = progress + '%';
            progressText.textContent = Math.round(progress) + '%';
            
            // Update question number
            document.querySelector('.text-sm.text-gray-600').textContent = `Pregunta ${currentQuestion} de 5`;
            
            // Reset question
            document.querySelectorAll('button').forEach(btn => {
                if (btn.onclick && btn.onclick.toString().includes('selectAnswer')) {
                    btn.classList.remove('border-quizzal-accent', 'bg-quizzal-accent', 'text-white', 'border-green-500', 'bg-green-500', 'border-red-500', 'bg-red-500');
                    btn.classList.add('border-gray-200');
                }
            });
            
            document.getElementById('feedback').classList.add('hidden');
            document.getElementById('next-btn').disabled = true;
            
            // Update question content (demo purposes)
            const questions = [
                "¿Cuál es el resultado de 15 + 27?",
                "¿Cuál es el resultado de 8 × 7?",
                "¿Cuál es el resultado de 144 ÷ 12?",
                "¿Cuál es el resultado de 25 - 13?",
                "¿Cuál es el resultado de 3² + 4²?"
            ];
            
            if (currentQuestion <= questions.length) {
                document.querySelector('h4').textContent = questions[currentQuestion - 1];
            }
        } else {
            // Show results
            alert(`¡Evaluación completada! Puntuación: ${score}/5 (${Math.round((score/5)*100)}%)`);
            // Reset for demo
            currentQuestion = 1;
            score = 0;
            document.querySelector('.progress-bar').style.width = '20%';
            document.querySelector('.text-2xl').textContent = '20%';
            document.querySelector('.text-sm.text-gray-600').textContent = 'Pregunta 1 de 5';
            document.getElementById('feedback').classList.add('hidden');
            document.getElementById('next-btn').disabled = true;
        }
    }
</script>
